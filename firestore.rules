rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Super Master Admin Config
    match /master_admin/{document=**} {
      allow read, write: if true;
    }

    // License Management (Trial, Expiry, Master Approval)
    match /licenses/{document=**} {
      allow read, write: if true;
    }

    // Staff Approval Requests (Top-Level & Collection Group)
    match /staff_requests/{document=**} {
      allow read, write: if true;
    }
    match /{path=**}/staff/{document=**} {
      allow read, write: if true;
    }

    // Companies Metadata
    match /companies/{document=**} {
      allow read, write: if true;
    }

    // Company Users & Role Mapping
    match /company_users/{document=**} {
      allow read, write: if true;
    }

    // User Profiles
    match /profiles/{document=**} {
      allow read, write: if true;
    }

    // Multi-tenant Tenant POS Data (Products, Sales, Purchases, Customers, Staff, etc.)
    match /users/{document=**} {
      allow read, write: if true;
    }
  }
}

