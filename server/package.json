{
  "name": "kadaikutty-pos-server",
  "version": "1.0.0",
  "description": "Backend API for KadaKutty POS",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node dist/index.js",
    "check:release": "node check-release.cjs",
    "dev": "nodemon src/index.ts",
    "build": "tsc",
    "pretest": "npm run build",
    "test": "node --test dist/__tests__/**/*.test.js",
    "seed:master": "node dist/scripts/seedMaster.js",
    "check:legacy": "node ../scripts/check-legacy-cloud-free.cjs"
  },
  "overrides": {
    "protobufjs": "^7.6.3",
    "@grpc/grpc-js": "^1.10.0"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.883.0",
    "@aws-sdk/client-dynamodb": "^3.883.0",
    "@aws-sdk/client-s3": "^3.883.0",
    "@aws-sdk/client-secrets-manager": "^3.883.0",
    "@aws-sdk/client-sns": "^3.1132.0",
    "@aws-sdk/lib-dynamodb": "^3.883.0",
    "@aws-sdk/s3-request-presigner": "^3.883.0",
    "aws-jwt-verify": "^5.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.3",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.5.1",
    "nodemon": "^3.0.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.6"
  }
}
