# KadaiKutty POS server - local development defaults.
# Copy to server/.env. See docs/LOCAL_DEVELOPMENT.md and docs/AWS_SETUP_GUIDE.md.

PORT=3000
NODE_ENV=development

# local  -> JSON file providers under LOCAL_DATA_DIR (no cloud needed)
# aws    -> Cognito + DynamoDB + S3 + Secrets Manager + SNS (see AWS block below)
PROVIDER_MODE=local
LOCAL_DATA_DIR=.local-data

# Development OTP shortcuts (ignored when NODE_ENV=production)
LOCAL_DEV_OTP_CODE=123456
# LOCAL_DEV_OTP_BYPASS=true

# Browser origins allowed for CORS. Empty = allow all in development; required in production.
ALLOWED_ORIGINS=

# Local-mode Super Master credentials (AWS mode reads these from DynamoDB + Secrets Manager;
# seed them with `npm run seed:master -- <mobile> <pin>`)
MASTER_SUPPORT_PHONE=9876543210
MASTER_ADMIN_PIN=123456

# Both must be >= 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace_with_a_secure_random_string_at_least_32_chars_long
RESET_SECRET=replace_with_a_secure_random_string_at_least_32_chars_long

# ---- AWS provider (PROVIDER_MODE=aws) ----
# Values come from the CloudFormation stack outputs (aws-infrastructure/setup-aws-resources.ps1 prints them).
# App Runner receives them automatically; only set them here for running against AWS from a laptop.
#AWS_REGION=ap-south-1
#AWS_COGNITO_USER_POOL_ID=ap-south-1_xxxxxxxxx
#AWS_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
#AWS_COGNITO_PHONE_COUNTRY_CODE=+91
#AWS_DYNAMODB_TABLE=kadaikutty-pos-production
#AWS_S3_BACKUP_BUCKET=kadaikutty-pos-backups-<account>-ap-south-1-production
#AWS_PRESIGNED_URL_SECONDS=300
#AWS_MASTER_PIN_SECRET_ARN=arn:aws:secretsmanager:ap-south-1:<account>:secret:/kadaikutty-pos/production/master-pin-xxxxxx
#
# SMS Provider configuration (when PROVIDER_MODE=aws)
# SMS_PROVIDER=msg91 (default) or sns
# When SMS_PROVIDER=msg91, the following are required (no fallback credentials in code):
#MSG91_WIDGET_ID=replace_with_msg91_widget_id
#MSG91_TOKEN_AUTH=replace_with_msg91_token_auth
#MSG91_AUTH_KEY=replace_with_msg91_auth_key

# Shown on the public privacy-policy and account-deletion pages that Google Play requires.
# Nothing is invented if these are unset: the pages just show the phone/support contact instead.
LEGAL_ENTITY_NAME=
SUPPORT_EMAIL=
