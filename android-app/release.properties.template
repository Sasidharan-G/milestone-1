# KadaKutty POS - Production Release Build Properties
# Copy this file to release.properties (or pass as environment variables in CI/CD)

# 1. Deployed Backend Base URL (MUST be explicit https:// domain, cannot be 10.0.2.2 or localhost)
# Current live backend (2026-09-17): Elastic Beanstalk (kadaikutty-pos-production, ap-southeast-2)
# fronted by an API Gateway HTTP API for HTTPS, since the EB load balancer itself has no TLS and
# there is no custom domain yet. Replace with your own domain's URL once you have one — see
# docs/AWS_SETUP_GUIDE.md "HTTPS without a custom domain" section.
BACKEND_BASE_URL=https://u3bmxkaw25.execute-api.ap-southeast-2.amazonaws.com/

# 2. Master Support Phone in E.164 format (e.g. +91 followed by 10 digits)
MASTER_SUPPORT_PHONE=+919840000000

# 3. Crash Analytics
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# 4. Keystore Signing Configuration (Optional if provided by CI env)
KADAIKUTTY_KEYSTORE_FILE=kadaikutty.jks
KADAIKUTTY_KEY_ALIAS=kadaikutty_key
KADAIKUTTY_STORE_PASSWORD=your_store_password
KADAIKUTTY_KEY_PASSWORD=your_key_password
